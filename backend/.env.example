# Database
DATABASE_URL=postgresql+psycopg://pos_user:pos_password@localhost:5432/sistem_pos

# JWT
JWT_SECRET=change-me-in-production
JWT_ALGORITHM=HS256
JWT_EXPIRES_MINUTES=60
JWT_REFRESH_EXPIRES_DAYS=7

# Seed (default admin; wajib ganti SEED_ADMIN_PASSWORD sebelum production,
# karena ENVIRONMENT=production akan menolak nilai default "admin123")
SEED_ADMIN_USERNAME=owner
SEED_ADMIN_PASSWORD=admin123

# CORS
CORS_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173"]